{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitDock",
  "version": "0.1.0",
  "identifier": "app.gitdock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "GitDock",
      "width": 1440,
      "height": 900,
      "minWidth": 1100,
      "minHeight": 700,
      "center": true,
      "dragDropEnabled": false,
      "decorations": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": null }
  }
}
